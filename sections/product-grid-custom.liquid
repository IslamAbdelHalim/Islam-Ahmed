<style>
  .custom-product-grid {
    max-width: calc(100% - 100px);
    margin: 0 auto;
    padding: 72px 24px 84px;
  }

  .custom-product-grid__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 30px;
  }

  .custom-product-grid__title {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 400;
  }

  {% comment %} .custom-product-grid__link {
    color: #000;
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  } {% endcomment %}

  .custom-product-grid__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .custom-product-card {
    min-width: 0;
    color: #000;
    text-decoration: none;
  }

  .custom-product-card__media {
    position: relative;
  }

  .custom-product-card__plus {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: 12%;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #000;
    font-size: 18px;
    font-weight: 400;
    line-height: 1;
    cursor: pointer;
  }

  .custom-product-card__plus:hover {
    background: #000;
    color: #fff;
  }

  .custom-product-dialog {
    width: 350px;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .custom-product-dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
  }

  .custom-product-dialog__panel {
    position: relative;
    display: grid;
    grid-template-columns: 38% 62%;
    grid-template-rows: auto auto;
    align-items: stretch;
    overflow: hidden;
    background: #fff;
  }

  .custom-product-dialog__media {
    padding: 40px 0 0 16px;
    grid-column: 1;
    grid-row: 1;
  }

  .custom-product-dialog__image {
    display: block;
    width: 100%;
    height: 160px;
    object-fit: cover;
  }

  .custom-product-dialog__details {
    grid-column: 2;
    grid-row: 1;
    padding: 40px 22px 24px 8px;
  }

  .custom-product-dialog__details h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 400;
  }

  .custom-product-dialog__price {
    margin: 22px 0 0;
    font-size: 1rem;
  }

  .custom-product-dialog__description {
    margin-top: 16px;
    font-size: 0.8rem;
    line-height: 1.2;
  }

  .custom-product-dialog__form {
    grid-column: 1 / -1;
    grid-row: 2;
    margin-top: 10px;
    padding: 0 22px 20px;
  }

  .custom-product-dialog__option {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .custom-product-dialog__option + .custom-product-dialog__option {
    margin-top: 14px;
  }

  .custom-product-dialog__option legend {
    margin-bottom: 8px;
    font-size: 0.8rem;
  }

  .custom-product-dialog__choices {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .custom-product-dialog__choice {
    position: relative;
    display: block;
  }

  .custom-product-dialog__choice input {
    position: absolute;
    opacity: 0;
  }

  .custom-product-dialog__choice span {
    display: block;
    padding: 10px 14px;
    border: 1px solid #999;
    font-size: 0.9rem;
  }

  .custom-product-dialog__choice + .custom-product-dialog__choice span {
    border-left: 0;
  }

  .custom-product-dialog__choice input:checked + span {
    border: 2px solid #000;
    padding: 9px 13px;
  }

  .custom-product-dialog__select {
    width: 100%;
    height: 46px;
    padding: 11px 56px 11px 14px;
    border: 0;
    border-radius: 0;
    background: #fff;
    font: inherit;
    font-size: 0.9rem;
    appearance: none;
    cursor: pointer;
  }

  .custom-product-dialog__select-wrap {
    position: relative;
    border: 1px solid #999;
  }

  .custom-product-dialog__select-arrow {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: 60px;
    height: 44px;
    border-left: 1px solid #999;
    font-size: 25px;
    line-height: 1;
    pointer-events: none;
  }

  .custom-product-dialog__submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 40px;
    padding: 14px 24px;
    border: 0;
    background: #000;
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .custom-product-dialog__submit:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .custom-product-dialog__details a {
    display: none;
  }

  .custom-product-dialog__details p {
    color: #555;
  }

  .custom-product-dialog__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #000;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .custom-product-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1.18;
    background: #f2f2f2;
    object-fit: cover;
  }

  .custom-product-card__info {
    padding-top: 12px;
  }

  .custom-product-card__name,
  .custom-product-card__price {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .custom-product-card__price {
    margin-top: 4px;
    color: #555;
  }

  .custom-product-grid__empty {
    padding: 48px 24px;
    background: #f5f5f5;
    text-align: center;
  }

  @media (max-width: 700px) {
    .custom-product-grid {
      padding: 48px 16px 56px;
    }

    .custom-product-grid__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .custom-product-grid__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .custom-product-dialog__panel {
      grid-template-columns: 38% 62%;
      grid-template-rows: auto auto;
    }

    .custom-product-dialog__media {
      grid-row: 1;
      padding: 40px 0 0 16px;
    }

    .custom-product-dialog__image {
      height: 140px;
    }

    .custom-product-dialog__details {
      grid-row: 1;
      padding: 40px 16px 18px 8px;
    }

    .custom-product-dialog__form {
      grid-column: 1 / -1;
      grid-row: 2;
      padding: 0 16px 20px;
    }
  }
</style>

<section class="custom-product-grid" aria-labelledby="product-grid-title-{{ section.id }}">
  {% assign product_collection = section.settings.collection | default: collections.all %}

  <div class="custom-product-grid__header">
    <h2 id="product-grid-title-{{ section.id }}" class="custom-product-grid__title">
      {{ section.settings.heading | default: 'Tisso vison in the wild' }}
    </h2>
  </div>

  {% if product_collection.products_count > 0 %}
    <div class="custom-product-grid__items">
      {% for product in product_collection.products limit: section.settings.products_to_show %}
        <div class="custom-product-card">
          <div class="custom-product-card__media">
            {% if product.featured_image %}
              {{ product.featured_image
                | image_url: width: 700
                | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(max-width: 700px) 50vw, 33vw', class: 'custom-product-card__image', alt: product.featured_image.alt | default: product.title
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'custom-product-card__image' }}
            {% endif %}
            {% render 'custom-product-hotspot', product: product, section: section %}
          </div>
          <div class="custom-product-card__info">
            <p class="custom-product-card__name">{{ product.title }}</p>
            <p class="custom-product-card__price">{{ product.price | money }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p class="custom-product-grid__empty">Add products to the selected collection to show them here.</p>
  {% endif %}
</section>

<script>
  (() => {
    document.querySelectorAll('[data-product-dialog-open]').forEach((button) => {
      if (button.dataset.productDialogReady) return;
      button.dataset.productDialogReady = 'true';
      button.addEventListener('click', () => {
        const dialog = document.getElementById(button.dataset.productDialogOpen);
        if (dialog && !dialog.open) dialog.showModal();
      });
    });

    document.querySelectorAll('[data-product-dialog-close]').forEach((button) => {
      if (button.dataset.productDialogReady) return;
      button.dataset.productDialogReady = 'true';
      button.addEventListener('click', () => button.closest('[data-product-dialog]')?.close());
    });

    document.querySelectorAll('[data-product-dialog]').forEach((dialog) => {
      if (dialog.dataset.productDialogReady) return;
      dialog.dataset.productDialogReady = 'true';
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Custom product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop our collection" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 3, "max": 12, "step": 3, "default": 6 }
  ],
  "presets": [
    { "name": "Custom product grid" }
  ]
}
{% endschema %}